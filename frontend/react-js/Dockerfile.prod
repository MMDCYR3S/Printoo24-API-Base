# ===== مرحله اول: Build =====
FROM node:22-bookworm AS build-stage

WORKDIR /app

# تنظیم npm registry
RUN npm config set registry https://registry.npmmirror.com/

# کپی package files
COPY package.json package-lock.json ./

# نصب dependencies
RUN npm ci --legacy-peer-deps || npm install

# کپی تمام سورس کد
COPY . .

# Build application
RUN npm run build

# بررسی که dist ساخته شده
RUN echo "=== Build Output ===" && ls -la dist/ && echo "=== Files in dist ===" && ls -la dist/

# ===== مرحله دوم: Nginx =====
FROM nginx:stable-alpine

# حذف فایل‌های پیش‌فرض nginx
RUN rm -rf /usr/share/nginx/html/*

# کپی فایل‌های build شده
COPY --from=build-stage /app/dist /usr/share/nginx/html/

# کپی تنظیمات nginx (اگه وجود داره)
COPY --from=build-stage /app/nginx/nginx.conf /etc/nginx/conf.d/default.conf 2>/dev/null || echo "No custom nginx.conf found"

# بررسی فایل‌های کپی شده
RUN echo "=== Nginx HTML Directory ===" && ls -la /usr/share/nginx/html/

# Expose port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

# اجرای nginx
CMD ["nginx", "-g", "daemon off;"]