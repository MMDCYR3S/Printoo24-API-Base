# مرحله انتخاب ایمیج پایه - استفاده از نسخه سبک Alpine
FROM node:20-alpine

# تنظیم دایرکتوری کاری
WORKDIR /app

# کپی فایل‌های شناسنامه پروژه برای نصب پکیج‌ها
# این کار باعث می‌شود اگر کدها تغییر کرد اما پکیج جدیدی اضافه نشد، این لایه دوباره بیلد نشود (سرعت بالا)
COPY package.json package-lock.json ./


# نصب پکیج‌ها
RUN npm install --legacy-peer-deps

# کپی بقیه فایل‌ها (برای محیط توسعه که Volume داریم، این لایه در اجرا اورراید می‌شود)
COPY . .

# باز کردن پورت (طبق تنظیمات ویت در فایل آپلودی شما: 5174)
EXPOSE 5173

# اجرای اپلیکیشن در حالت توسعه با دسترسی Host برای دیده شدن بیرون از کانتینر
CMD ["npm", "run", "dev", "--", "--host"]