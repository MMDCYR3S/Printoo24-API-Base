# ===== General ===== #
DEBUG=0
SECRET_KEY=YOUR-SUPER-STRONG-SECRET-KEY-CHANGE-THIS-IN-PRODUCTION
# ALLOWED_HOSTS=187.124.27.96,187.124.27.96.com,YOUR_SERVER_IP
DJANGO_SETTINGS_MODULE=customer_site.settings.production

# ===== CSRF & CORS ===== #
# CSRF_TRUSTED_ORIGINS=http://187.124.27.96:9010,http://187.124.27.96:5173
# CORS_ALLOWED_ORIGINS=http://187.124.27.96:5173,http://187.124.27.96:3000

# ===== Security (بعد از نصب SSL فعال کن) ===== #
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# ===== PostgreSQL Database ===== #
POSTGRES_DB=printo24_db
POSTGRES_USER=printo24_user
POSTGRES_PASSWORD=printo24_pass
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ===== Redis Cache & Celery Broker ===== #
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}